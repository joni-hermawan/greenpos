# Copy this file to .env and fill in what you have. Anything left blank
# falls back to a safe simulator default — the backend always starts clean.

PORT=8080
DATA_DIR=./data
TOKEN_TTL_HOURS=12
# Signs/verifies login JWTs. Leave blank in dev — a random one is generated
# each run (fine, since sessions are in-memory only anyway and a restart
# already requires re-login). Set a fixed value if you ever need a token
# issued by one run to still verify after a restart.
JWT_SECRET=

# QRIS via Midtrans Core API. Leave MIDTRANS_SERVER_KEY blank to use the
# built-in simulator (fake qr_string, auto-settles ~3s after charge) —
# fill it in once you have sandbox credentials from dashboard.midtrans.com
# and QRIS starts hitting the real sandbox with zero code changes.
MIDTRANS_ENV=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# EDC card payments. simulator (default) needs nothing. live requires a
# completed Prima Vista onboarding (TSD spec §2.4): a paired EDC id, an
# API key, an mTLS client cert/key + their root CA, and an ECDSA P-256
# signing key for ES256 request signatures.
EDC_MODE=simulator
EDC_WS_URL=
EDC_API_KEY=
EDC_CLIENT_CERT_PATH=
EDC_CLIENT_KEY_PATH=
EDC_ROOT_CA_PATH=
EDC_SIGNING_PRIVATE_KEY_PATH=
